# Environment variables for AI Multi-Asset Trading Bot
# Non-negotiable: live trading is locked unless MODE=live AND LIVE_CONFIRM=I_UNDERSTAND_THE_RISK

# Operational Mode: demo | backtest | live
MODE=demo
LIVE_CONFIRM=

# OANDA API (Practice/Demo account)
OANDA_ACCOUNT_ID=
OANDA_API_KEY=
OANDA_ENVIRONMENT=practice  # practice | live

# Alpaca API (Paper Trading)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# AI Decision Model
LLM_PROVIDER=gemini  # gemini | anthropic
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-2.5-flash

# News & Calendar Providers (Option A: ForexFactory + CryptoPanic; Fallback: Finnhub)
NEWS_PROVIDER=cryptopanic
CALENDAR_PROVIDER=forexfactory
# CryptoPanic Developer Auth Token: Free registration at https://cryptopanic.com/developers/api/
# Required for coin-specific filtering and higher API rate limits. (Optional: public unauthenticated feed used if empty)
CRYPTOPANIC_AUTH_TOKEN=
# Finnhub API Key: Free registration at https://finnhub.io/ (60 req/min free tier, used as pluggable fallback)
FINNHUB_API_KEY=

# Telegram Alerts & Remote Control
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Storage & Runtime
DATABASE_URL=sqlite:///trading_bot.db
LOG_LEVEL=INFO
